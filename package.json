{
  "name": "@menuqr/windows-bridge",
  "version": "0.1.3",
  "private": true,
  "description": "MenüQR Windows Integration Bridge",
  "main": "dist/main/index.js",
  "author": "MenüQR",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Trillianti/menueqr-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trillianti/menueqr-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Trillianti/menueqr-bridge/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:assets",
    "test": "jest --selectProjects unit --runInBand",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "npm run build && playwright test --config playwright.config.ts",
    "virtual-printer": "electron tools/virtual-printer/main.cjs",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:win:update": "npm run build && electron-builder --win nsis --x64 --config electron-builder.release.yml --publish always",
    "publish:updates": "node scripts/publish-updates.mjs",
    "verify:published-updates": "node scripts/verify-published-updates.mjs",
    "verify:architecture": "jest --selectProjects unit --runInBand tests/unit/architecture-boundaries.spec.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
